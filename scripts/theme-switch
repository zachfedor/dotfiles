#!/usr/bin/env python3
"""theme-switch: apply a base16 scheme across Alacritty, Neovim, and Doom Emacs.

No external theming tool involved (see docs/adr/0009-base16-theme-switching.md
for why) — this reads a flat base16 scheme file (scheme:/author:/base00:..
base0F: keys) and writes the three tool-specific adapter files directly.

A "family" is a scheme name (e.g. "nord", "solarized"); a family with both
light and dark looks has two scheme files, <family>-dark.yaml and
<family>-light.yaml. Families with only one look just have <family>.yaml.
Switching family is manual; switching variant (dark/light) within the current
family is meant to be driven by an OS-appearance watcher (not built yet).

Usage:
  theme-switch <family>              switch to <family>, keeping the current
                                      variant (falls back to dark on first run)
  theme-switch --variant dark|light  reapply the current family in VARIANT
  theme-switch --list                list available families
"""
import argparse
import os
import pathlib
import subprocess
import sys

DOTFILES = pathlib.Path(os.environ.get("DOTFILES", str(pathlib.Path.home() / ".dotfiles")))
SCHEMES_DIR = DOTFILES / "theme" / "schemes"
STATE_DIR = pathlib.Path.home() / ".local" / "state" / "theme"
STATE_FILE = STATE_DIR / "current"

BASE16_KEYS = [f"base0{c}" for c in "0123456789ABCDEF"]


def parse_scheme(path):
    colors = {}
    with open(path) as f:
        for line in f:
            line = line.strip()
            if not line or line.startswith("#"):
                continue
            key, _, value = line.partition(":")
            key = key.strip()
            value = value.strip().strip('"').strip("'")
            if key in BASE16_KEYS:
                colors[key] = value if value.startswith("#") else f"#{value}"
    missing = [k for k in BASE16_KEYS if k not in colors]
    if missing:
        sys.exit(f"error: {path} is missing {', '.join(missing)}")
    return colors


def find_scheme_file(family, variant):
    for candidate in (SCHEMES_DIR / f"{family}-{variant}.yaml", SCHEMES_DIR / f"{family}.yaml"):
        if candidate.exists():
            return candidate
    sys.exit(
        f"error: no scheme file for family '{family}' "
        f"(looked for {family}-{variant}.yaml and {family}.yaml in {SCHEMES_DIR})"
    )


def write_alacritty(c):
    path = pathlib.Path.home() / ".config" / "alacritty" / "colors.toml"
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(
        f"""# Generated by theme-switch; do not edit by hand.

[colors.primary]
background = "{c['base00']}"
foreground = "{c['base05']}"

[colors.cursor]
text = "{c['base00']}"
cursor = "{c['base05']}"

[colors.normal]
black = "{c['base00']}"
red = "{c['base08']}"
green = "{c['base0B']}"
yellow = "{c['base0A']}"
blue = "{c['base0D']}"
magenta = "{c['base0E']}"
cyan = "{c['base0C']}"
white = "{c['base05']}"

[colors.bright]
black = "{c['base03']}"
red = "{c['base08']}"
green = "{c['base0B']}"
yellow = "{c['base0A']}"
blue = "{c['base0D']}"
magenta = "{c['base0E']}"
cyan = "{c['base0C']}"
white = "{c['base07']}"
"""
    )


# Core highlight groups only (not base16-vim's ~200) — small and fully
# self-contained beats exhaustive-but-dependent on an unverified plugin API.
NEOVIM_FACES = """\
hl(0, 'Normal', { fg = c.base05, bg = c.base00 })
hl(0, 'CursorLine', { bg = c.base01 })
hl(0, 'Visual', { bg = c.base02 })
hl(0, 'Comment', { fg = c.base03, italic = true })
hl(0, 'Constant', { fg = c.base09 })
hl(0, 'String', { fg = c.base0B })
hl(0, 'Identifier', { fg = c.base08 })
hl(0, 'Function', { fg = c.base0D })
hl(0, 'Statement', { fg = c.base0E })
hl(0, 'PreProc', { fg = c.base0A })
hl(0, 'Type', { fg = c.base0A })
hl(0, 'Special', { fg = c.base0C })
hl(0, 'Underlined', { fg = c.base0D, underline = true })
hl(0, 'Error', { fg = c.base08, bold = true })
hl(0, 'Todo', { fg = c.base0A, bg = c.base01, bold = true })
hl(0, 'LineNr', { fg = c.base03 })
hl(0, 'CursorLineNr', { fg = c.base04 })
hl(0, 'Pmenu', { fg = c.base05, bg = c.base01 })
hl(0, 'PmenuSel', { fg = c.base00, bg = c.base05 })
hl(0, 'DiffAdd', { fg = c.base0B })
hl(0, 'DiffDelete', { fg = c.base08 })
hl(0, 'DiffChange', { fg = c.base0D })
"""


def write_neovim(c, variant):
    path = pathlib.Path.home() / ".config" / "nvim" / "colors-current.lua"
    path.parent.mkdir(parents=True, exist_ok=True)
    color_table = "\n".join(f"  {k} = '{v}'," for k, v in c.items())
    path.write_text(
        f"""-- Generated by theme-switch; do not edit by hand.
vim.o.background = '{variant}'
local c = {{
{color_table}
}}
local hl = vim.api.nvim_set_hl
{NEOVIM_FACES}"""
    )


def write_emacs(c):
    path = DOTFILES / "doom" / "themes" / "theme-colors.el"
    path.parent.mkdir(parents=True, exist_ok=True)
    plist = " ".join(f':{k} "{v}"' for k, v in c.items())
    path.write_text(
        f""";;; theme-colors.el --- generated by theme-switch, do not edit by hand -*- lexical-binding: t; -*-
(setq base16-dotfiles-theme-colors
      '({plist}))
"""
    )


def apply(family, variant):
    colors = parse_scheme(find_scheme_file(family, variant))
    write_alacritty(colors)
    write_neovim(colors, variant)
    write_emacs(colors)
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    STATE_FILE.write_text(f"{family}\n{variant}\n")
    try:
        subprocess.run(
            ["emacsclient", "--eval", "(zf/reload-base16-theme)"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            timeout=2,
        )
    except (FileNotFoundError, subprocess.TimeoutExpired):
        pass
    print(f"applied {family} ({variant})")


def current():
    if STATE_FILE.exists():
        lines = STATE_FILE.read_text().split()
        if len(lines) == 2:
            return lines[0], lines[1]
    return "onedark", "dark"


def list_families():
    families = set()
    for p in SCHEMES_DIR.glob("*.yaml"):
        stem = p.stem
        if stem.endswith("-dark") or stem.endswith("-light"):
            stem = stem.rsplit("-", 1)[0]
        families.add(stem)
    for family in sorted(families):
        print(family)


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    group = parser.add_mutually_exclusive_group()
    group.add_argument("family", nargs="?", help="scheme family to switch to (e.g. nord, gruvbox-dark)")
    group.add_argument("--variant", choices=["dark", "light"], help="reapply the current family in this variant")
    group.add_argument("--list", action="store_true", help="list available families")
    args = parser.parse_args()

    if args.list:
        list_families()
        return

    cur_family, cur_variant = current()
    if args.variant:
        apply(cur_family, args.variant)
    elif args.family:
        apply(args.family, cur_variant)
    else:
        parser.print_help()
        sys.exit(1)


if __name__ == "__main__":
    main()
